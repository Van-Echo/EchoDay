        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"categories\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"color_value\" INTEGER NOT NULL, \"sort_order\" REAL NOT NULL DEFAULT 0.0, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, \"revision\" INTEGER NOT NULL DEFAULT 1, PRIMARY KEY (\"id\"));"
